{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": null,
  "outputDirectory": ".",
  "installCommand": "echo \"static site - no install\"",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/game/:path*",
      "has": [{ "type": "host", "value": "aleville.vercel.app" }],
      "destination": "/game/:path*"
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "aleville.vercel.app" }],
      "destination": "/game/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
